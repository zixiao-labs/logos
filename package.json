{
  "name": "logos-editor",
  "private": false,
  "version": "1.4.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "predev": "npm run prepackage:debug-adapters",
    "dev": "nasti dev",
    "build": "nasti build",
    "preview": "nasti preview",
    "preelectron": "npm run prepackage:debug-adapters",
    "electron": "nasti electron",
    "build:app": "nasti electron-build",
    "prepackage:servers": "node scripts/install-language-servers.mjs",
    "prepackage:debug-adapters": "node scripts/install-debug-adapters.mjs",
    "dist": "npm run build:app && npm run prepackage:servers && npm run prepackage:debug-adapters && electron-builder --publish never",
    "release": "npm run build:app && npm run prepackage:servers && npm run prepackage:debug-adapters && electron-builder --publish always",
    "electron:build": "npm run dist",
    "postinstall": "electron-rebuild",
    "test": "lightning run",
    "test:e2e": "lightning run --config lightning.e2e.config.ts",
    "test:watch": "lightning watch",
    "test:coverage": "lightning run --config lightning.coverage.config.ts --coverage",
    "typecheck": "tsc --noEmit && npm -w @logos-editor/extension-api run typecheck"
  },
  "author": "Zixiao Laboratories",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "build": {
    "appId": "com.zixiaolabs.logos",
    "productName": "Logos",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "!**/*.map",
      "!node_modules/monaco-editor/**",
      "!node_modules/@gravity-ui/**",
      "!node_modules/@xterm/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/marked/**",
      "!node_modules/zustand/**"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/@anthropic-ai/claude-agent-sdk/**",
      "**/node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "afterPack": "scripts/afterPack.cjs",
    "publish": {
      "provider": "github",
      "owner": "zixiao-labs",
      "repo": "logos"
    },
    "mac": {
      "icon": "icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "category": "Development",
      "maintainer": "Zixiao Laboratories",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.21.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.159",
    "@gravity-ui/icons": "^2.18.0",
    "@heroui/react": "^3.2.0",
    "@heroui/styles": "^3.2.0",
    "@logos-editor/extension-api": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chen-the-dawnstreak": "^4.2.2",
    "electron-updater": "^6.8.3",
    "marked": "^18.0.4",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-git": "^3.36.0",
    "tailwind-variants": "^3.2.2",
    "tar": "^7.5.19",
    "unbzip2-stream": "^1.4.3",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.18.2",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@lightning-js/lightning": "^2.0.0",
    "@nasti-toolchain/nasti": "^2.0.0",
    "@tailwindcss/node": "^4.3.1",
    "@tailwindcss/oxide": "^4.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/unbzip2-stream": "^1.4.3",
    "@types/yauzl": "^3.4.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.8.1",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "npm@11.16.0"
}

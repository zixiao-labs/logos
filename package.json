{
  "name": "logos-editor",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "nasti dev",
    "build": "nasti build",
    "preview": "nasti preview",
    "electron": "nasti electron",
    "build:app": "nasti electron-build",
    "prepackage:servers": "node scripts/install-language-servers.mjs",
    "dist": "npm run build:app && npm run prepackage:servers && electron-builder --publish never",
    "release": "npm run build:app && npm run prepackage:servers && electron-builder --publish always",
    "electron:build": "npm run dist",
    "postinstall": "electron-rebuild",
    "typecheck": "tsc --noEmit"
  },
  "author": "Zixiao Laboratories",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "build": {
    "appId": "com.zixiaolabs.logos",
    "productName": "Logos",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/monaco-editor/**",
      "!node_modules/@gravity-ui/**",
      "!node_modules/@xterm/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/marked/**",
      "!node_modules/zustand/**"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/@anthropic-ai/claude-agent-sdk/**",
      "**/node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "afterPack": "scripts/afterPack.cjs",
    "publish": {
      "provider": "github",
      "owner": "zixiao-labs",
      "repo": "logos"
    },
    "mac": {
      "icon": "icons/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        { "target": "nsis", "arch": "x64" }
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "category": "Development",
      "maintainer": "Zixiao Laboratories",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.159",
    "@gravity-ui/icons": "^2.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "chen-the-dawnstreak": "^4.2.2",
    "electron-updater": "^6.8.3",
    "marked": "^18.0.4",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-git": "^3.36.0",
    "vscode-jsonrpc": "^8.2.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@nasti-toolchain/nasti": "^1.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
